{
  "name": "uco-recovery-station",
  "version": "0.1.0",
  "private": true,
  "description": "UCO Recovery Station — kiosk app, dashboard, and shared backend",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:migrate": "npm run db:migrate -w @uco/api",
